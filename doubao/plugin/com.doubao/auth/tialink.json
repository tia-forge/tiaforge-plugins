{
  "credentials": [
    {
      "id": "apiKey",
      "label": "TiaLink 令牌",
      "description": "在网关控制台 http://localhost:8080/ 里查看/生成",
      "required": true,
      "secret": true
    }
  ],
  "injections": [
    {
      "target": "header",
      "name": "Authorization",
      "value": "Bearer ${apiKey}"
    }
  ]
}
